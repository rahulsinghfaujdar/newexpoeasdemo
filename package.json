    "expo-linking": "~57.0.7",
    "expo-localization": "~57.0.1",
    "expo-router": "~57.0.16",
    "expo-splash-screen": "~57.0.8",
    "expo-sqlite": "~57.0.1",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.2",
    "expo-system-ui": "~57.0.2",
    "expo-web-browser": "~57.0.2",
    "lucide-react-native": "^1.68.0",
    "posthog-react-native": "^4.64.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
