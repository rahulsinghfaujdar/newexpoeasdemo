    "react-native-svg": "15.15.4",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@posthog/cli": "^0.15.0",
    "@vitejs/plugin-react": "^5.0.0",
    "@types/react": "~19.2.2",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~57.0.2",
    "typescript": "~6.0.3",
    "vite": "^7.0.0"
  },
  "scripts": {
    "install:expo": "npm i && npx expo install",
    "check:expo": "npx expo install --check",
    "start": "expo start",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "vite --config vite.config.mjs",
    "web:expo": "expo start --web",
    "lint": "expo lint",
    "build:androidapk": "eas build --platform android",
    "build:androidaab": "eas build --platform android",
    "build:android:apk:release": "cd android && ./gradlew assembleRelease -Pposthog.dotenvFile=../.env.local",
    "build:android:aab:release": "cd android && ./gradlew bundleRelease -Pposthog.dotenvFile=../.env.local",
    "build:ios": "eas build --platform ios",
    "build:web": "vite build --config vite.config.mjs",
    "build:web:expo": "expo export --platform web",
    "build:web:deploy:eas":"eas deploy"
  },
  "private": true
